# Set the final HTTPS domain in Netlify. Never commit secrets.
SITE_URL=https://ohhzaz.com
# Enable only after the final domain/content/media approval.
SITE_INDEXABLE=false

# Optional Google HTML meta tag token, copied from Search Console (not the HTML filename).
GOOGLE_SITE_VERIFICATION=
# Server-only PostgreSQL connection URL. For Supabase on Netlify use the transaction pooler.
# Never use NEXT_PUBLIC_ for this value. Previews must not receive production credentials.
DATABASE_URL=
DATABASE_PROVIDER=supabase
# Production domain is connected through Cloudflare DNS to Netlify.
