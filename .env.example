# Set the final HTTPS domain in Netlify. Never commit secrets.
SITE_URL=https://ohhzaz-by-siham.netlify.app
# Enable only after the final domain/content/media approval.
SITE_INDEXABLE=false

# Optional Google HTML meta tag token, copied from Search Console (not the HTML filename).
GOOGLE_SITE_VERIFICATION=
# Admin/catalogue backend: PUBLIC anon key only; NEVER a service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# After the owner buys/connects the domain, replace SITE_URL with https://ohhzaz.com.
